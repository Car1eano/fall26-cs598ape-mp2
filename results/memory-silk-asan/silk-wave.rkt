#lang racket

;;===== Symbolic Image Reconstruction =====


(require racket/draw)
(provide red green blue render)

(define-syntax-rule (define-channel (name X) expr ...)
  (define (name X)
    (let ([values (list expr ...)])
      (/ (apply + values) (length values)))))

;;Loading benchmark/silk-waves.png
(define (model-input X) (list (+ (* 6.28318548 (list-ref X 0)) -3.14159274) (+ (* 6.28318548 (list-ref X 1)) -3.14159274)))
